{
  "name": "gridlens-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:ci": "playwright test --project=regression",
    "test:live": "playwright test --project=live-acceptance",
    "test:login": "playwright test -c playwright.login.config.ts",
    "generate:api": "openapi-typescript src/api/openapi.json -o src/api/generated.ts"
  },
  "dependencies": {
    "d3-geo": "3.1.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "topojson-client": "3.1.0",
    "us-atlas": "3.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/d3-geo": "3.1.0",
    "@types/geojson": "7946.0.16",
    "@types/node": "22.20.5",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "@vitejs/plugin-react": "4.5.0",
    "openapi-typescript": "7.8.0",
    "typescript": "5.8.3",
    "vite": "6.4.4"
  }
}
