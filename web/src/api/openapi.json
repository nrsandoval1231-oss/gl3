{
  "openapi": "3.1.0",
  "info": {
    "title": "GridLens API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/auth/login": {
      "post": {
        "summary": "Login",
        "operationId": "login_api_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "summary": "Logout",
        "operationId": "logout_api_auth_logout_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogoutOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/session": {
      "get": {
        "summary": "Auth Session",
        "operationId": "auth_session_api_auth_session_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/opportunities": {
      "get": {
        "summary": "Opportunities",
        "operationId": "opportunities_api_opportunities_get",
        "parameters": [
          {
            "name": "tier",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Tier"
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Search"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OpportunityOut"
                  },
                  "title": "Response Opportunities Api Opportunities Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/changes": {
      "get": {
        "summary": "Changes",
        "operationId": "changes_api_changes_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ChangeOut"
                  },
                  "type": "array",
                  "title": "Response Changes Api Changes Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/refresh": {
      "post": {
        "summary": "Refresh",
        "operationId": "refresh_api_refresh_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshOut"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChangeOut": {
        "properties": {
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "published_at": {
            "type": "string",
            "format": "date",
            "title": "Published At"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "title",
          "url",
          "published_at"
        ],
        "title": "ChangeOut"
      },
      "EvidenceOut": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "abstract": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Abstract"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "published_at": {
            "type": "string",
            "format": "date",
            "title": "Published At"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time",
            "title": "Retrieved At"
          },
          "extraction_location": {
            "type": "string",
            "title": "Extraction Location"
          },
          "content_hash": {
            "type": "string",
            "title": "Content Hash"
          },
          "event_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Event Date"
          },
          "event_date_label": {
            "type": "string",
            "title": "Event Date Label"
          },
          "source_id": {
            "type": "string",
            "title": "Source Id"
          },
          "document_number": {
            "type": "string",
            "title": "Document Number"
          }
        },
        "type": "object",
        "required": [
          "title",
          "abstract",
          "url",
          "published_at",
          "retrieved_at",
          "extraction_location",
          "content_hash",
          "event_date",
          "event_date_label",
          "source_id",
          "document_number"
        ],
        "title": "EvidenceOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthOut": {
        "properties": {
          "sources": {
            "items": {
              "$ref": "#/components/schemas/HealthSourceOut"
            },
            "type": "array",
            "title": "Sources"
          },
          "backlog": {
            "type": "integer",
            "title": "Backlog"
          },
          "pending_interpretations": {
            "type": "integer",
            "title": "Pending Interpretations"
          }
        },
        "type": "object",
        "required": [
          "sources",
          "backlog",
          "pending_interpretations"
        ],
        "title": "HealthOut"
      },
      "HealthSourceOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "family": {
            "type": "string",
            "title": "Family"
          },
          "geography": {
            "type": "string",
            "title": "Geography"
          },
          "last_attempt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Attempt"
          },
          "last_success": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Success"
          },
          "new_records": {
            "type": "integer",
            "title": "New Records",
            "default": 0
          },
          "changed_records": {
            "type": "integer",
            "title": "Changed Records",
            "default": 0
          },
          "parse_failures": {
            "type": "integer",
            "title": "Parse Failures",
            "default": 0
          },
          "pdf_candidates": {
            "type": "integer",
            "title": "Pdf Candidates",
            "default": 0
          },
          "pdf_eligible": {
            "type": "integer",
            "title": "Pdf Eligible",
            "default": 0
          },
          "pdf_enriched": {
            "type": "integer",
            "title": "Pdf Enriched",
            "default": 0
          },
          "pdf_skipped_not_signal": {
            "type": "integer",
            "title": "Pdf Skipped Not Signal",
            "default": 0
          },
          "pdf_skipped_limit": {
            "type": "integer",
            "title": "Pdf Skipped Limit",
            "default": 0
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "latest_publication_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest Publication Date"
          }
        },
        "type": "object",
        "required": [
          "id",
          "status",
          "family",
          "geography"
        ],
        "title": "HealthSourceOut"
      },
      "LoginBody": {
        "properties": {
          "password": {
            "type": "string",
            "format": "password",
            "title": "Password",
            "writeOnly": true
          }
        },
        "type": "object",
        "required": [
          "password"
        ],
        "title": "LoginBody"
      },
      "LoginOut": {
        "properties": {
          "authenticated": {
            "type": "boolean",
            "title": "Authenticated"
          },
          "expires_at": {
            "type": "integer",
            "title": "Expires At"
          }
        },
        "type": "object",
        "required": [
          "authenticated",
          "expires_at"
        ],
        "title": "LoginOut"
      },
      "LogoutOut": {
        "properties": {
          "authenticated": {
            "type": "boolean",
            "title": "Authenticated"
          }
        },
        "type": "object",
        "required": [
          "authenticated"
        ],
        "title": "LogoutOut"
      },
      "OpportunityOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location"
          },
          "tier": {
            "type": "string",
            "title": "Tier"
          },
          "activity": {
            "type": "string",
            "title": "Activity"
          },
          "rationale": {
            "type": "string",
            "title": "Rationale"
          },
          "required_mw": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Required Mw"
          },
          "start_window": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Window"
          },
          "duration": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration"
          },
          "supply": {
            "type": "string",
            "title": "Supply"
          },
          "next_action": {
            "type": "string",
            "title": "Next Action"
          },
          "conflict_state": {
            "type": "string",
            "title": "Conflict State"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/EvidenceOut"
            },
            "type": "array",
            "title": "Evidence"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "location",
          "tier",
          "activity",
          "rationale",
          "required_mw",
          "start_window",
          "duration",
          "supply",
          "next_action",
          "conflict_state",
          "evidence"
        ],
        "title": "OpportunityOut"
      },
      "RefreshOut": {
        "properties": {
          "queued": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Queued"
          }
        },
        "type": "object",
        "required": [
          "queued"
        ],
        "title": "RefreshOut"
      },
      "SessionOut": {
        "properties": {
          "authenticated": {
            "type": "boolean",
            "title": "Authenticated"
          }
        },
        "type": "object",
        "required": [
          "authenticated"
        ],
        "title": "SessionOut"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
