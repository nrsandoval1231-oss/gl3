# Copy to /opt/gridlens/.env.prod on the droplet (chmod 600). Never commit it.
DATABASE_URL=postgresql+psycopg://gridlens:CHANGE@db-host:25060/gridlens?sslmode=require
# Plain libpq URL for pg_dump backups (same database, no +psycopg)
BACKUP_DATABASE_URL=postgresql://gridlens:CHANGE@db-host:25060/gridlens?sslmode=require
APP_PASSWORD_HASH=bcrypt-hash
SESSION_SECRET=64-hex-chars
COOKIE_SECURE=true
TRUSTED_ORIGINS=https://gridlens.example.com
# Keep true: the worker plans hourly sources and missing-fact research at their own cadence.
WORKER_AUTO_REFRESH=true
# Autonomous retained/public analysis runs without user-triggered workflows.
OPPORTUNITY_ENRICHMENT_ENABLED=true
COMPANY_CONTACT_DISCOVERY_ENABLED=true
AUTONOMOUS_RESEARCH_ENABLED=true
AUTONOMOUS_RESEARCH_DAILY_QUESTIONS=8
# This profile grants no paid acquisition/model budget.
AUTONOMOUS_RESEARCH_MAX_COST_USD=0
BUYING_CHAIN_PUBLIC_RESEARCH_ENABLED=false
SCHEDULE_TIMEZONE=America/Chicago
SCHEDULE_ANCHOR_TIME=07:00:00
# OPENAI_API_KEY and TYPESAFE_API_KEY live in Infisical (project 06ded1a4-5c85-426a-a833-d40358529795,
# environment `dev`, path `/`) and are injected by with-infisical.sh. Leave them out of this file.
# Optional FIRECRAWL_API_KEY uses the same server-only injection when authorized.
# For integration deployment, merge intelligence.disabled.env.example first;
# enabled provider/monitoring flags and all finite caps require explicit activation.
JEV_ENABLED=false
NTFY_URL=https://ntfy.sh/your-private-topic
NTFY_TOKEN=
CLOUDFLARE_TUNNEL_TOKEN=
SPACES_KEY=
SPACES_SECRET=
SPACES_REGION=nyc3
SPACES_BUCKET=gridlens-artifacts
# Optional read-only operational receipt; leave blank to report UNKNOWN.
OPERATIONAL_RECEIPT_FILE=
# To enable: set OPERATIONAL_RECEIPT_FILE=/run/gridlens/operational-receipt.json
# and OPERATIONAL_RECEIPT_HOST_FILE=/opt/gridlens/operational-receipt.json after the
# backup command has created that regular host file. The default mount is /dev/null.
