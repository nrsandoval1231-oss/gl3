FROM node:22-alpine AS build
WORKDIR /app
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web ./
ARG GRIDLENS_BUILD_SHA
ARG GRIDLENS_DEPLOYMENT_ENVIRONMENT
ARG GRIDLENS_DEPLOYED_AT
ENV VITE_GIT_SHA=$GRIDLENS_BUILD_SHA \
    VITE_DEPLOYMENT_ENVIRONMENT=$GRIDLENS_DEPLOYMENT_ENVIRONMENT \
    VITE_DEPLOYED_AT=$GRIDLENS_DEPLOYED_AT
COPY deploy/validate-web-build.sh /usr/local/bin/validate-web-build.sh
RUN sh /usr/local/bin/validate-web-build.sh && npm run build

FROM nginx:1.28-alpine
RUN apk upgrade --no-cache
# The runtime configuration uses only core proxy/static directives. Remove the
# unused pinned modules so apk can upgrade nginx to Alpine's patched revision.
RUN apk del nginx-module-acme nginx-module-geoip nginx-module-image-filter nginx-module-njs nginx-module-xslt \
    && sed -i '/^nginx=/s/=.*$//' /etc/apk/world \
    && apk upgrade --no-cache
RUN rm -f /etc/nginx/conf.d/default.conf && mkdir -p /run/nginx
COPY deploy/nginx.conf /etc/nginx/http.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
