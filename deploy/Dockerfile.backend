FROM python:3.11-slim
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy PYTHONUNBUFFERED=1
WORKDIR /app
COPY --from=ghcr.io/astral-sh/uv:0.7.13 /uv /uvx /bin/
COPY backend/pyproject.toml backend/uv.lock ./backend/
RUN cd backend && uv sync --locked --no-dev --no-install-project
COPY backend/alembic.ini ./backend/
COPY backend/migrations ./backend/migrations
COPY backend/src ./backend/src
COPY config ./config
WORKDIR /app/backend
# Install the project in editable mode so imports resolve without PYTHONPATH
# and source-relative config paths stay at /app/config.
RUN uv sync --locked --no-dev
# The base image's global setuptools is build tooling only. The application
# runs from the uv environment and does not need this vulnerable bootstrap copy.
RUN python -m pip uninstall -y setuptools
ENV UV_NO_SYNC=1
# Run unprivileged. Application code and the virtualenv stay root-owned and
# read-only to the runtime user; only the home directory (uv cache) is writable,
# plus the system temp directory used by document-fetch adapters.
RUN useradd --system --create-home --home-dir /home/app --uid 10001 --user-group app
ENV HOME=/home/app UV_CACHE_DIR=/home/app/.cache/uv
USER app
CMD ["uv", "run", "uvicorn", "gridlens.api.app:app", "--host", "0.0.0.0", "--port", "8000", "--no-proxy-headers"]
