# .env is for native local runs. scripts/setup_local.py writes it and it stays ignored.
# .env.compose is for Compose. scripts/setup_compose.py writes it.
# compose.yaml and `docker compose --env-file .env.compose` read .env.compose, not .env.
# Replace every value before exposing the service.
POSTGRES_PASSWORD=replace-with-a-long-random-password
COMPOSE_DATABASE_URL=postgresql+psycopg://gridlens:replace-with-a-long-random-password@db:5432/gridlens
DATABASE_URL=postgresql+psycopg://gridlens:replace-with-a-long-random-password@db:5432/gridlens
TEST_DATABASE_URL=postgresql+psycopg://gridlens:replace-with-a-long-random-password@db:5432/gridlens_test
APP_PASSWORD_HASH=replace-with-bcrypt-hash
SESSION_SECRET=replace-with-at-least-64-random-hex-characters
COOKIE_SECURE=true
SESSION_HOURS=12
TRUSTED_PROXY_CIDRS=
LOGIN_WINDOW_SECONDS=60
LOGIN_CLIENT_LIMIT=5
LOGIN_GLOBAL_LIMIT=500
LOGIN_CLIENT_BUCKET_CAP=10000
WORKER_AUTO_REFRESH=true
SCHEDULE_TIMEZONE=America/Chicago
SCHEDULE_ANCHOR_TIME=07:00:00
PURSUITS_DAILY_FETCH_LIMIT=160
PURSUITS_DAILY_MODEL_LIMIT=8
OPENAI_API_KEY=
OPENAI_BRIEF_MODEL=gpt-4.1-mini
BRIEFS_DAILY_REQUEST_LIMIT=8
TYPESAFE_API_KEY=
JEV_ENABLED=false
JEV_SHADOW_MODE=true
JEV_SHADOW_BATCH_LIMIT=20
JEV_SHADOW_DAILY_LIMIT=20
JEV_SHADOW_TIMEOUT_SECONDS=90
TRUSTED_ORIGINS=https://gridlens.example.com
AUTONOMOUS_RESEARCH_ENABLED=true
AUTONOMOUS_RESEARCH_DAILY_QUESTIONS=8
AUTONOMOUS_RESEARCH_MAX_SEARCHES=3
AUTONOMOUS_RESEARCH_MAX_URLS=10
AUTONOMOUS_RESEARCH_MAX_DOCUMENT_BYTES=750000
AUTONOMOUS_RESEARCH_MAX_DOCUMENTS=5
AUTONOMOUS_RESEARCH_TIMEOUT_SECONDS=180

# Optional public research discovery/extraction; leave unset to disable paid acquisition.
# FIRECRAWL_API_KEY=
# FIRECRAWL_SEARCH_COST_USD=
# FIRECRAWL_SCRAPE_COST_USD=
# AUTONOMOUS_RESEARCH_MAX_COST_USD=0
