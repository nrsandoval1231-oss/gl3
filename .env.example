# Copy to .env for Compose. Replace every value before exposing the service.
POSTGRES_PASSWORD=replace-with-a-long-random-password
COMPOSE_DATABASE_URL=postgresql+psycopg://gridlens:replace-with-a-long-random-password@db:5432/gridlens
DATABASE_URL=postgresql+psycopg://gridlens:replace-with-a-long-random-password@db:5432/gridlens
TEST_DATABASE_URL=postgresql+psycopg://gridlens:replace-with-a-long-random-password@db:5432/gridlens_test
APP_PASSWORD_HASH=replace-with-bcrypt-hash
SESSION_SECRET=replace-with-at-least-64-random-hex-characters
COOKIE_SECURE=true
SESSION_HOURS=12
WORKER_AUTO_REFRESH=true
PURSUITS_DAILY_FETCH_LIMIT=160
PURSUITS_DAILY_MODEL_LIMIT=8
OPENAI_API_KEY=
OPENAI_BRIEF_MODEL=gpt-4.1-mini
BRIEFS_DAILY_REQUEST_LIMIT=8
TYPESAFE_API_KEY=
TRUSTED_ORIGINS=https://gridlens.example.com
